# Get your free Neon database at https://neon.tech
# After creating a project, copy the connection string here:
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/upmind?sslmode=require
NEXTAUTH_SECRET=your-secret-key-here-change-this
NEXTAUTH_URL=http://localhost:3000

# ZAI AI Service Configuration
ZAI_BASE_URL=https://your-ai-service-url/v1
ZAI_API_KEY=your-api-key
ZAI_CHAT_ID=
ZAI_TOKEN=
ZAI_USER_ID=

# LM Studio Configuration (for Gemma 12B local model)
# 1. Open LM Studio
# 2. Download Gemma 3 12B (GGUF, Q4_K_M recommended)
# 3. Go to Local Server tab -> Load model -> Start Server
# 4. Default URL is http://localhost:1234/v1
# 5. For production: use ngrok to expose your local server publicly
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=gemma-3-12b-it
