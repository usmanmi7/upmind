# Get your free Neon database at https://neon.tech
# After creating a project, copy the connection string here:
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/upmind?sslmode=require
NEXTAUTH_SECRET=your-secret-key-here-change-this
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — "Continue with Google" button on /auth/login and /auth/signup
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a project (or pick existing) -> Enable "Google+ API" and "Google Calendar API" (optional)
# 3. Configure OAuth consent screen (External, fill app name, logo, developer email)
# 4. Create Credentials -> OAuth client ID -> Web application
# 5. Add Authorized JavaScript origins:
#      http://localhost:3000            (local dev)
#      https://enginest.vercel.app      (production)
# 6. Add Authorized redirect URIs:
#      http://localhost:3000/api/auth/callback/google
#      https://enginest.vercel.app/api/auth/callback/google
# 7. Copy the Client ID and Client Secret here, and ALSO set them in
#    Vercel: Project -> Settings -> Environment Variables
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NVIDIA Build API — powers Enginest AI (the chat assistant)
# 1. Sign in at https://build.nvidia.com
# 2. Go to https://build.nvidia.com/moonshotai/kimi-k3 -> click "Get API Key"
# 3. Generate a key (starts with "nvapi-...")
# 4. Set these in Vercel: Project -> Settings -> Environment Variables
# Free tier: 1,000 credits/month (resets monthly).
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=moonshotai/kimi-k3
# NVIDIA_BASE_URL is optional, defaults to https://integrate.api.nvidia.com/v1

# ZAI AI Service Configuration
ZAI_BASE_URL=https://your-ai-service-url/v1
ZAI_API_KEY=your-api-key
ZAI_CHAT_ID=
ZAI_TOKEN=
ZAI_USER_ID=

# LM Studio Configuration (for Gemma 12B local model)
# 1. Open LM Studio
# 2. Download Gemma 3 12B (GGUF, Q4_K_M recommended)
# 3. Go to Local Server tab -> Load model -> Start Server
# 4. Default URL is http://localhost:1234/v1
# 5. For production: use ngrok to expose your local server publicly
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=gemma-3-12b-it
