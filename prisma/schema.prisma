// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String?
  image           String?
  role            Role      @default(FREE_USER)
  phone           String?
  country          String?
  bio             String?
  emailVerified   Boolean   @default(false)
  twoFactorEnabled Boolean @default(false)
  banned          Boolean   @default(false)
  bannedReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  startup         Startup?
  subscription    Subscription?
  consultant      Consultant?
  appointments    Appointment[]
  messagesSent    Message[]  @relation("SentMessages")
  documents       Document[]
  notifications   Notification[]
  savedResources  SavedResource[]
  resourceAuthor  Resource[]
  achievements    Achievement[]
  posts           CommunityPost[]
  comments        Comment[]
  postLikes       PostLike[]
  resourceViews   ResourceView[]
  jobApplications JobApplication[]
  sessions        Session[]
  accounts        Account[]
  chats           Chat[]
  skills          UserSkill[]
  innovationMatches InnovationMatch[]
}

enum Role {
  FREE_USER
  PAID_USER
  CONSULTANT
  ADMIN
  SUPER_ADMIN
}

model Startup {
  id            String    @id @default(cuid())
  userId        String    @unique
  name          String
  industry      String?
  teamSize      String?
  vision        String?
  goals         String?
  pitchDeckUrl  String?
  businessStage String?
  revenueStage  String?
  website       String?
  socialLinks   String?
  progress      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         Task[]
  roadmapItems  RoadmapItem[]
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String    @unique
  plan          Plan      @default(FREE)
  status        SubscriptionStatus @default(ACTIVE)
  startDate     DateTime  @default(now())
  endDate       DateTime?
  autoRenew     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      Payment[]
}

enum Plan {
  FREE
  GROWTH_PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

model Payment {
  id             String    @id @default(cuid())
  subscriptionId String
  amount         Float
  currency       String    @default("USD")
  status         PaymentStatus @default(PENDING)
  method         String?
  invoiceUrl     String?
  createdAt      DateTime  @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Consultant {
  id            String    @id @default(cuid())
  userId        String    @unique
  specialties   String?
  bio           String?
  rating        Float     @default(0)
  availability  String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id])
  appointments  Appointment[]
}

model Appointment {
  id            String    @id @default(cuid())
  userId        String
  consultantId  String?
  date          DateTime
  duration      Int       @default(60)
  type          MeetingType @default(VIDEO)
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?
  meetingUrl    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id])
  consultant    Consultant? @relation(fields: [consultantId], references: [id])
}

enum MeetingType {
  VIDEO
  PHONE
  IN_PERSON
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model Resource {
  id            String    @id @default(cuid())
  title         String
  slug          String?   @unique
  description   String?
  content       String?   @db.Text
  type          ResourceType
  category      String?
  tags          String?
  readTime      String?   @default("5 min")
  coverImage    String?
  fileUrl       String?
  thumbnailUrl  String?
  isPremium     Boolean   @default(false)
  downloadCount Int       @default(0)
  authorId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author        User?     @relation(fields: [authorId], references: [id])
  savedBy       SavedResource[]
  views         ResourceView[]
}

enum ResourceType {
  BLOG
  TEMPLATE
  VIDEO
  PDF
  GUIDE
}

model SavedResource {
  id          String    @id @default(cuid())
  userId      String
  resourceId  String
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
}

model ResourceView {
  id          String    @id @default(cuid())
  userId      String
  resourceId  String
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resourceId])
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  receiverId  String?
  content     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  sender      User      @relation(fields: [senderId], references: [id], name: "SentMessages")
}

model Task {
  id          String    @id @default(cuid())
  startupId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  assignedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  startup     Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model RoadmapItem {
  id          String    @id @default(cuid())
  startupId   String
  phase       String
  title       String
  description String?
  order       Int       @default(0)
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())

  startup     Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)
}

model Document {
  id          String    @id @default(cuid())
  userId      String
  name        String
  fileUrl     String
  fileType    String
  size        Int
  folder      String    @default("General")
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  title       String
  message     String
  type        NotificationType
  isRead      Boolean   @default(false)
  link        String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  MESSAGE
  APPOINTMENT
  PAYMENT
  RESOURCE
  SYSTEM
}

model Blog {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  category    String?
  tags        String?
  isPublished Boolean   @default(false)
  authorId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FAQ {
  id          String    @id @default(cuid())
  question    String
  answer      String
  category    String?
  order       Int       @default(0)
  isPublished Boolean   @default(true)
}

model Testimonial {
  id          String    @id @default(cuid())
  name        String
  role        String?
  company     String?
  content     String
  image       String?
  rating      Int?
  isPublished Boolean   @default(true)
  order       Int       @default(0)
}

model Achievement {
  id          String          @id @default(cuid())
  userId      String
  type        AchievementType
  title       String
  description String
  earnedAt    DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityPost {
  id         String    @id @default(cuid())
  title      String
  content    String
  category   String    @default("general")
  authorId   String
  likes      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments   Comment[]
  likedBy    PostLike[]

  @@index([category])
  @@index([authorId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  userId String

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

enum AchievementType {
  FIRST_LOGIN
  PROFILE_COMPLETE
  FIRST_APPOINTMENT
  RESOURCE_DOWNLOAD
  TASK_MASTER
  MILESTONE_5
  MILESTONE_10
  COMMUNITY_MEMBER
  EARLY_ADOPTER
  ROADMAP_STARTER
  RESOURCE_EXPLORER
  SOCIAL_BUTTERFLY
  CONSULTATION_PRO
  VISIONARY
  STARTUP_PROFILE
}

model JobApplication {
  id          String            @id @default(cuid())
  userId      String
  jobTitle    String
  department  String
  fullName    String
  email       String
  phone       String?
  resumeUrl   String?
  coverLetter String?           @db.Text
  linkedIn    String?
  portfolio   String?
  status      ApplicationStatus @default(PENDING)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEWED
  OFFERED
  REJECTED
  WITHDRAWN
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String  @id @default(cuid())
  sessionToken String  @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// AI chat conversations (persisted for logged-in users only)
model Chat {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

/// Individual messages inside an AI chat conversation
model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String   // "user" | "assistant"
  content   String
  structuredJson String? // JSON-stringified StructuredAIResponse, if any
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SOLVE THEM — Engineering Innovation Platform models
// ─────────────────────────────────────────────────────────────────────────────

/// World problems collected from WHO, UN, UNICEF, World Bank, research papers,
/// etc. The heart of the Solve Them platform. Each problem has rich metadata
/// for filtering, scoring, and matching engineers to problems they can solve.
model Problem {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  summary         String   // 1-2 sentence description (public)
  description     String   @db.Text // full description (public)

  // Categorization
  category        String   // e.g. "Healthcare", "Climate Change", "AI"
  tags            String[] @default([]) // multi-tag for flexible filtering
  source          String?  // e.g. "WHO", "United Nations", "Research Paper"
  sourceUrl       String?

  // Scope
  scope           ProblemScope @default(GLOBAL) // GLOBAL | REGIONAL | NATIONAL
  regions         String[] @default([]) // e.g. ["Sri Lanka", "South Asia"]
  countriesAffected String[] @default([])
  peopleAffected  String?  // e.g. "19 Million+" (kept as string for display)

  // Scoring (0-100 unless noted)
  severity        Int      @default(50) // how bad is this problem?
  difficulty      Int      @default(5)  // 1-10 scale
  marketNeed      Int      @default(50) // demand for solutions
  globalDemand    Int      @default(50) // % of world that needs this solved
  futureImportance Int     @default(50) // how important in 10 years
  innovationScore Int      @default(50) // how much room for innovation
  impactScore     Int      @default(50) // estimated impact if solved

  // Solvability
  canEngineersSolve Boolean @default(true)
  engineerSolvableNote String? // brief note on why/why not

  // Timeline estimates (in months) for a typical team
  estimatedTimeline Int?   // e.g. 4 (months)

  // Filtering flags
  difficultyLevel DifficultyLevel @default(MEDIUM) // EASY | MEDIUM | HARD | EXTREME
  projectTypes    String[] @default([]) // ["Startup", "Research", "Product", ...]

  // Visibility / publishing
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations — locked content accessible to logged-in users
  solutions       ProblemSolution[]
  skills          ProblemSkill[]
  teamTemplates   ProblemTeam[]
  roadmaps        ProblemRoadmap[]
  innovationMatches InnovationMatch[]

  @@index([category])
  @@index([difficultyLevel])
  @@index([isPublished])
}

enum ProblemScope {
  GLOBAL
  REGIONAL
  NATIONAL
  LOCAL
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  EXTREME
}

/// Engineering solutions for a problem — "What can engineers build?"
/// Multiple solutions per problem, each is a concrete buildable thing.
model ProblemSolution {
  id          String   @id @default(cuid())
  problemId   String
  title       String   // e.g. "AI Flood Prediction Platform"
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

/// Skills required to work on a problem. Used by the AI Innovation Engine
/// to match user skills to problems.
model ProblemSkill {
  id          String   @id @default(cuid())
  problemId   String
  skill       String   // e.g. "Python", "Machine Learning", "Computer Vision"
  importance  Int      @default(5) // 1-10, how critical for this problem
  createdAt   DateTime @default(now())

  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, skill])
  @@index([problemId])
  @@index([skill])
}

/// Recommended team structure for tackling a problem.
/// One problem can have multiple team templates (e.g. small vs large team).
model ProblemTeam {
  id            String   @id @default(cuid())
  problemId     String
  templateName  String   @default("Recommended Team") // e.g. "Lean Team", "Full Team"
  minMembers    Int      @default(3)
  maxMembers    Int      @default(8)
  estimatedTimelineMonths Int? // e.g. 4
  roles         String[] @default([]) // ["AI Engineer", "Backend Engineer", ...]
  createdAt     DateTime @default(now())

  problem       Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

/// Development roadmap for solving a problem — phased plan with tasks.
model ProblemRoadmap {
  id          String   @id @default(cuid())
  problemId   String
  phase       String   // e.g. "Research", "Prototype", "MVP", "Scale"
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  duration    String?  // e.g. "2 weeks"
  createdAt   DateTime @default(now())

  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

/// Skills a user has — used by the AI Innovation Engine for matching.
/// Users add these via their profile or the Innovation Engine form.
model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  skill     String
  proficiency Int    @default(3) // 1-5 self-rated
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@index([userId])
  @@index([skill])
}

/// Saved results from the AI Innovation Engine — when a user runs
/// "Generate Innovations", we save the matches for later reference.
model InnovationMatch {
  id          String   @id @default(cuid())
  userId      String
  problemId   String
  matchScore  Int      // 0-100, how well the problem matched the user's input
  inputSnapshot String @db.Text // JSON: { skills, interests, time, teamSize }
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
}
